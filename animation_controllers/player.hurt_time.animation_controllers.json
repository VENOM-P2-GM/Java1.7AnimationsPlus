{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.player.hurt_time": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.previous_hurt_time = v.hurt_time;"
          ],
          "transitions": [
            { "test_hurt_time": "1.0" }
          ]
        },
        "test_hurt_time": {
          "transitions": [
            { "reset_hurt_time": "q.approx_eq(v.previous_hurt_time, v.hurt_time)" }, // Variable stopped updating, we can assume the hurt animation is done.
            { "default": "1.0" }
          ]
        },
        "reset_hurt_time": {
          "on_entry": [
            "v.hurt_time = 0.0;"
          ],
          "transitions": [
            { "default": "v.hurt_time > 0.0" }
          ]
        }
      }
    },

    // BUG: `is_hurt_color` doesn't evaluate when player is invisible, so damage particles won't show in this circumstance.
    "controller.animation.player.hurt_particle": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "emit": "v.hurt_time > 0.0" }
          ]
        },
        "emit": {
          /*"particle_effects": [
            { "effect": "hurt" }
          ],*/
          "animations": [
            "emit_hurt_particle"
          ],
          "transitions": [
            { "default": "v.hurt_time <= 0.0" }
          ]
        }
      }
    }
  }
}