{
  "format_version": "1.10.0",
  "animations": {
    "animation.actor.billboard": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [ "q.camera_rotation(0)", "q.camera_rotation(1)", 0.0 ],

          // As of 1.21.100, projectiles are scaled to be more in parity with java.
          // Change `t.scale_multiplier` to your liking if you are using < 1.21.100.
          "scale": [
            "t.scale_multiplier = -0.8; return q.model_scale * 16.0 * t.scale_multiplier;",
            "t.scale_multiplier = 0.8; return q.model_scale * 16.0 * t.scale_multiplier;",
            "t.scale_multiplier = 0.8; return q.model_scale * 16.0 * t.scale_multiplier;"
          ]
        }
      }
    }
  }
}