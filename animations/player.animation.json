    "animation.player.attack.rotations": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [ 0.0, "v.attack_body_rot_y", "q.is_sneaking ? v.attack_body_rot_y * -0.4 : 0.0" ]
        },
        "leftarm": {
          "rotation": [ "v.attack_body_rot_y", 0.0, 0.0 ]
        },
        "leftarm_custom": {
          "rotation": [ "v.attack_body_rot_y", 0.0, 0.0 ]
        },
        "rightarm": {
          // The exact implementation from MCJE doesnt look the same in MCBE because the attack update variable (i.e. `v.attack_time`) updates differently...
          // v.attack_time -> math.pow(v.attack_time, 0.85)
          "rotation": [
            //"t.f1 = math.sin(1 - (math.pow(1 - v.attack_time, 3)) * 180); t.f2 = math.sin(v.attack_time * 180) * (q.head_x_rotation(0) - 40.1070456592) * 0.75; return t.f1 * 68.7549354157 + t.f2;",
            "math.sin(1 - (math.pow(1 - math.pow(v.attack_time, 0.85), 3)) * 180) * 68.7549354157 + math.sin(math.pow(v.attack_time, 0.85) * 180) * (q.head_x_rotation(0) - 40.1070456592) * 0.75",
            "v.attack_body_rot_y * 2.0",
            "math.sin(v.attack_time * 180) * -22.9183118052"
          ]
        },
        "rightarm_custom": {
          "rotation": [
            "math.sin(1 - (math.pow(1 - math.pow(v.attack_time, 0.85), 3)) * 180) * 68.7549354157 + math.sin(math.pow(v.attack_time, 0.85) * 180) * (q.head_x_rotation(0) - 40.1070456592) * 0.75",
            "v.attack_body_rot_y * 2.0",
            "math.sin(v.attack_time * 180) * -22.9183118052"
          ]
        }
      }
    },
    "animation.player.cape": {
      "loop": true,
      "bones": {
        "cape": {
          "position": [ 0.0, "q.get_root_locator_offset('armor_offset.default_neck', 1)", 0.0 ],
          "rotation": [
            "t.oscillation_amount = (q.is_sneaking ? 0.0 : math.sin(v.modified_distance_moved * 55.0) * 3.0 * (1.0 - v.swim_amount) * v.modified_move_speed); return (v.is_in_menu ? -6.0 : (q.is_sleeping ? 0 : math.clamp((q.cape_flap_amount * -110.25) - t.oscillation_amount - 0.75, -180.0, -1.5)));",
            "v.relative_cape_rotation * 60.0;",
            "v.relative_cape_rotation * -45.0"
          ]
        },
        // The dedicated engine cape render pass only auto-applies the `cape` animation to the cape
        // geometry. It does not run the entity's generic `animate` list (that list drives the main
        // humanoid model, where the cape segments do not exist), so the segment channels have to live
        // here inside `animation.player.cape` for the segmented cape to follow them.
        // The values are produced by the cape physics simulation in player.entity.json's `pre_animation`.
        // SIGN CONVENTION - the `cape` bone is rotated 180 degrees around Y (bind pose + `rotation: [0, 180, 0]`),
        // so every child bone inherits a mirrored frame: a local X rotation of +a on a child shows up as -a
        // in the parent's frame, and the same mirroring applies to Z. `animation.player.cape` swings the
        // cape backwards with a negative X rotation on the `cape` bone, therefore the segments use a
        // positive X rotation to keep trailing in that same direction. Y is not mirrored, so the segment
        // Y channels follow the cape's sign as-is.
        "cape_seg_1": {
          "rotation": [
            "v.cape_rx_1 + math.sin(q.life_time * 11.0) * v.cape_flutter * 2.6",
            "v.cape_ry_1 + math.sin(q.life_time * 9.0) * v.cape_flutter * 2.1",
            "v.relative_cape_rotation * 8.0 + math.sin(q.life_time * 8.0) * v.cape_flutter * 0.8"
          ]
        },
        "cape_seg_2": {
          "rotation": [
            "v.cape_rx_2 + math.sin(q.life_time * 11.0 + 1.1) * v.cape_flutter * 3.8",
            "v.cape_ry_2 + math.sin(q.life_time * 9.0 + 1.1) * v.cape_flutter * 3.1",
            "v.relative_cape_rotation * 8.0 + math.sin(q.life_time * 8.0 + 2.2) * v.cape_flutter * 1.2"
          ]
        },
        "cape_seg_3": {
          "rotation": [
            "v.cape_rx_3 + math.sin(q.life_time * 11.0 + 2.2) * v.cape_flutter * 5.2",
            "v.cape_ry_3 + math.sin(q.life_time * 9.0 + 2.2) * v.cape_flutter * 4.2",
            "v.relative_cape_rotation * 8.0 + math.sin(q.life_time * 8.0 + 4.4) * v.cape_flutter * 1.6"
          ]
        }
      }
    },
