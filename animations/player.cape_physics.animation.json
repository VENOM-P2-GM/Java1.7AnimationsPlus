// Cape physics (additive only - it never touches the Java 1.7 cape animation).
//
// `animation.player.cape` (the Java 1.7 port) keeps full control of the `cape` bone. This animation only
// drives the three child segments (`cape_seg_1/2/3`, see models/entity/cape.geo.json) with a simulated
// cloth response, so the cape whips and trails behind the player instead of swinging as one rigid plate.
//
// SIGN CONVENTION - this is the part that is easy to get wrong:
// The `cape` bone is rotated 180 degrees around Y (bind pose + `rotation: [0, 180, 0]`), so every child bone
// inherits a mirrored frame: a local X rotation of +a on a child shows up as -a in the parent's frame
// (R_y(180) * R_x(a) == R_x(-a) * R_y(180)), and the same mirroring applies to Z. The Java 1.7 cape
// animation swings the cape backwards with a *negative* X rotation on the `cape` bone, therefore the
// segments have to use a *positive* X rotation to keep trailing in that same direction. Y is not mirrored,
// so Y follows the cape bone's sign as-is.
//
// The simulation itself (velocity sampling + smoothing) lives in player.entity.json's `pre_animation`,
// following the same pattern the pack already uses for `v.modified_move_speed` / `v.relative_cape_rotation`.
// That way every value is integrated exactly once per frame, for every player that can render a cape.
// This file only reads those values and adds a speed-scaled travelling flutter wave.
//
// At rest every smoothed value decays back to 0.0, so the cape hangs exactly like the vanilla cape.
{
  "format_version": "1.10.0",
  "animations": {
    "animation.player.cape_physics": {
      "loop": true,
      "bones": {
        "cape_seg_1": {
          "rotation": [
            "v.cape_rx_1 + math.sin(q.life_time * 11.0) * v.cape_flutter * 2.0",
            "v.cape_ry_1 + math.sin(q.life_time * 9.0) * v.cape_flutter * 1.6",
            "v.relative_cape_rotation * 6.0 + math.sin(q.life_time * 8.0) * v.cape_flutter * 0.6"
          ]
        },
        "cape_seg_2": {
          "rotation": [
            "v.cape_rx_2 + math.sin(q.life_time * 11.0 + 1.1) * v.cape_flutter * 3.0",
            "v.cape_ry_2 + math.sin(q.life_time * 9.0 + 1.1) * v.cape_flutter * 2.4",
            "v.relative_cape_rotation * 6.0 + math.sin(q.life_time * 8.0 + 2.2) * v.cape_flutter * 0.9"
          ]
        },
        "cape_seg_3": {
          "rotation": [
            "v.cape_rx_3 + math.sin(q.life_time * 11.0 + 2.2) * v.cape_flutter * 4.0",
            "v.cape_ry_3 + math.sin(q.life_time * 9.0 + 2.2) * v.cape_flutter * 3.2",
            "v.relative_cape_rotation * 6.0 + math.sin(q.life_time * 8.0 + 4.4) * v.cape_flutter * 1.2"
          ]
        }
      }
    }
  }
}
