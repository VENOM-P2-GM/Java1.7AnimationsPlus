{
  "format_version": "1.10.0",
  "animations": {
    "animation.player.offset_custom_arm_height": {
      "loop": true,
      "bones": {
        // `v.short_arm_offset_left`/`v.short_arm_offset_right` only updates in first person, so on initial load/changing skins, the new value will not be evaluated until then.
        // `q.get_default_bone_pivot('leftarm', 1)`/`q.get_default_bone_pivot('rightarm', 1)` seems to randomly return 0 on wide arm skins in some circumstances.
        // Possibly due to the unexpected skeletal index as per the content log error...
        "leftarm_custom": {
          "position": [ 0, "-v.short_arm_offset_left", 0 ]
        },
        "rightarm_custom": {
          "position": [ 0, "-v.short_arm_offset_right", 0 ]
        }
      }
    }
  }
}