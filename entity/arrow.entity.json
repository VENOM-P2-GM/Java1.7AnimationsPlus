{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:arrow",
      "materials": {
        "default": "arrow",
        "ambient_uv": "ambient_uv"
      },
      "textures": {
        "default": "textures/entity/arrows",
        "fire": "textures/blocks/fire_0"
      },
      "geometry": {
        "default": "geometry.arrow",
        "fire": "geometry.projectile_fire"
      },
      "animations": {
        "move": "animation.arrow.move",
        "fire": "animation.projectile.fire"
      },
      "scripts": {
        "pre_animation": [
          "v.shake = q.shake_time - q.frame_alpha;",
          "v.shake_power = v.shake > 0.0 ? -math.sin(v.shake * 200.0) * v.shake : 0.0;"
        ],
        "animate": [
          "move",
          { "fire": "q.is_on_fire" }
        ]
      },
      "render_controllers": [
        "controller.render.arrow",
        { "controller.render.projectile.fire": "q.is_on_fire" }
      ]
    }
  }
}