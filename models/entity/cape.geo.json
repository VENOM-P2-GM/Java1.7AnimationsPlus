//
// The cape is split into a vertical chain of bones (`cape` -> `cape_seg_1` -> `cape_seg_2` -> `cape_seg_3`)
// so that `animation.player.cape_physics` can bend the lower part of the cape with simulated cloth motion.
// The top `cape` bone keeps the exact vanilla pivot / bind rotation / cube bounds, and the three segments
// split the remaining 12 pixels of the cape into 4 pixel slices, each pivoting at the top edge of its own
// cube and keeping the vanilla UV layout (uv y = 0, 4, 8, 12), so the cape texture is untouched and the
// segments line up perfectly at rest (they form the exact same 10x16x1 box as the vanilla cape).
// `geometry.cape_physics` / `geometry.cape_physics_root_parent` (models/entity/cape_physics.geo.json) are
// identical copies of these two geometries and are what player.entity.json binds the `cape` slots to;
// the identical copies exist so the segmented cape is used no matter whether the engine resolves the
// cape pass through the render controller's geometry expression or through the client entity `cape` slot.
{
  "format_version": "1.16.0",
  "minecraft:geometry": [
    {
      "description": {
        "identifier": "geometry.cape",
        "texture_width": 64,
        "texture_height": 32,
        "visible_bounds_width": 2,
        "visible_bounds_height": 1.5,
        "visible_bounds_offset": [ 0, 0.25, 0 ]
      },
      "bones": [
        {
          "name": "root",
          "pivot": [ 0, 0, 0 ]
        },
        {
          "name": "body",
          "pivot": [ 0, 24, 0 ],
          "parent": "waist"
        },
        {
          "name": "waist",
          "parent": "root",
          "neverRender": true,
          "pivot": [ 0, 12, 0 ]
        },
        {
          "name": "cape",
          "parent": "body",
          "pivot": [ 0, 24, 2 ],
          "bind_pose_rotation": [ 0, 180, 0 ],
          "rotation": [ 0, 180, 0 ],
          "cubes": [
            {
              "origin": [ -5, 20, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 0 ]
            }
          ]
        },
        {
          "name": "cape_seg_1",
          "parent": "cape",
          "pivot": [ 0, 20, 2 ],
          "cubes": [
            {
              "origin": [ -5, 16, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 4 ]
            }
          ]
        },
        {
          "name": "cape_seg_2",
          "parent": "cape_seg_1",
          "pivot": [ 0, 16, 2 ],
          "cubes": [
            {
              "origin": [ -5, 12, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 8 ]
            }
          ]
        },
        {
          "name": "cape_seg_3",
          "parent": "cape_seg_2",
          "pivot": [ 0, 12, 2 ],
          "cubes": [
            {
              "origin": [ -5, 8, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 12 ]
            }
          ]
        }
      ]
    },
    {
      "description": {
        "identifier": "geometry.cape_root_parent",
        "texture_width": 64,
        "texture_height": 32,
        "visible_bounds_width": 2,
        "visible_bounds_height": 1.5,
        "visible_bounds_offset": [ 0, 0.25, 0 ]
      },
      "bones": [
        {
          "name": "root",
          "pivot": [ 0, 0, 0 ]
        },
        {
          "name": "cape",
          "parent": "root",
          "pivot": [ 0, 24, 2 ],
          "bind_pose_rotation": [ 0, 180, 0 ],
          "rotation": [ 0, 180, 0 ],
          "cubes": [
            {
              "origin": [ -5, 20, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 0 ]
            }
          ]
        },
        {
          "name": "cape_seg_1",
          "parent": "cape",
          "pivot": [ 0, 20, 2 ],
          "cubes": [
            {
              "origin": [ -5, 16, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 4 ]
            }
          ]
        },
        {
          "name": "cape_seg_2",
          "parent": "cape_seg_1",
          "pivot": [ 0, 16, 2 ],
          "cubes": [
            {
              "origin": [ -5, 12, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 8 ]
            }
          ]
        },
        {
          "name": "cape_seg_3",
          "parent": "cape_seg_2",
          "pivot": [ 0, 12, 2 ],
          "cubes": [
            {
              "origin": [ -5, 8, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 12 ]
            }
          ]
        }
      ]
    }
  ]
}
