// Cape physics geometry.
// Segmented cape: the top bone (`cape`) is identical to the vanilla cape bone (same pivot, bind rotation and
// cube bounds), so the Java 1.7 cape animation binds to it exactly as before. The three child bones
// (`cape_seg_1/2/3`) split the lower 12 pixels of the cape into a chain, which `animation.player.cape_physics`
// drives with simulated cloth physics. Each slice keeps the exact vanilla UV layout so the cape texture is
// unaffected. These geometries replace the `cape` / `cape_root_parent` slots in player.entity.json only.
//
// NOTE: this file is a byte-for-byte mirror of `models/entity/cape.geo.json` (the only differences are the
// geometry identifiers). Keep both files in sync: `geometry.cape` / `geometry.cape_root_parent` are what the
// cape render controller resolves when the engine reads the geometry expression directly, while
// `geometry.cape_physics` / `geometry.cape_physics_root_parent` are what player.entity.json binds the
// `cape` / `cape_root_parent` slots to. Both paths must end up on the segmented model.
{
  "format_version": "1.16.0",
  "minecraft:geometry": [
    {
      "description": {
        "identifier": "geometry.cape_physics",
        "texture_width": 64,
        "texture_height": 32,
        "visible_bounds_width": 2,
        "visible_bounds_height": 1.5,
        "visible_bounds_offset": [ 0, 0.25, 0 ]
      },
      "bones": [
        {
          "name": "root",
          "pivot": [ 0, 0, 0 ]
        },
        {
          "name": "body",
          "pivot": [ 0, 24, 0 ],
          "parent": "waist"
        },
        {
          "name": "waist",
          "parent": "root",
          "neverRender": true,
          "pivot": [ 0, 12, 0 ]
        },
        {
          "name": "cape",
          "parent": "body",
          "pivot": [ 0, 24, 2 ],
          "bind_pose_rotation": [ 0, 180, 0 ],
          "rotation": [ 0, 180, 0 ],
          "cubes": [
            {
              "origin": [ -5, 20, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 0 ]
            }
          ]
        },
        {
          "name": "cape_seg_1",
          "parent": "cape",
          "pivot": [ 0, 20, 2 ],
          "cubes": [
            {
              "origin": [ -5, 16, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 4 ]
            }
          ]
        },
        {
          "name": "cape_seg_2",
          "parent": "cape_seg_1",
          "pivot": [ 0, 16, 2 ],
          "cubes": [
            {
              "origin": [ -5, 12, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 8 ]
            }
          ]
        },
        {
          "name": "cape_seg_3",
          "parent": "cape_seg_2",
          "pivot": [ 0, 12, 2 ],
          "cubes": [
            {
              "origin": [ -5, 8, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 12 ]
            }
          ]
        }
      ]
    },
    {
      "description": {
        "identifier": "geometry.cape_physics_root_parent",
        "texture_width": 64,
        "texture_height": 32,
        "visible_bounds_width": 2,
        "visible_bounds_height": 1.5,
        "visible_bounds_offset": [ 0, 0.25, 0 ]
      },
      "bones": [
        {
          "name": "root",
          "pivot": [ 0, 0, 0 ]
        },
        {
          "name": "cape",
          "parent": "root",
          "pivot": [ 0, 24, 2 ],
          "bind_pose_rotation": [ 0, 180, 0 ],
          "rotation": [ 0, 180, 0 ],
          "cubes": [
            {
              "origin": [ -5, 20, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 0 ]
            }
          ]
        },
        {
          "name": "cape_seg_1",
          "parent": "cape",
          "pivot": [ 0, 20, 2 ],
          "cubes": [
            {
              "origin": [ -5, 16, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 4 ]
            }
          ]
        },
        {
          "name": "cape_seg_2",
          "parent": "cape_seg_1",
          "pivot": [ 0, 16, 2 ],
          "cubes": [
            {
              "origin": [ -5, 12, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 8 ]
            }
          ]
        },
        {
          "name": "cape_seg_3",
          "parent": "cape_seg_2",
          "pivot": [ 0, 12, 2 ],
          "cubes": [
            {
              "origin": [ -5, 8, 1 ],
              "size": [ 10, 4, 1 ],
              "uv": [ 0, 12 ]
            }
          ]
        }
      ]
    }
  ]
}
