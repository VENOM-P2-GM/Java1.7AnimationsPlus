{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ambient:hurt",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false,
        "velocity": true
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:particle_initial_speed": "math.random(6.0, 16.0)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "6.0 / (math.random(0.0, 16.0) + 12.0)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          // Center vertically along hitbox.
          // All particle offsets are in units of 1/16'th of a block. An offset of 16 equates to 1 block in a given direction.
          // `t.player_eye_height = 1.62` -> the player eye height is exactly 1.62 blocks. When attached to an entity via a locator, the eye height is the origin.
          // `t.default_center_offset = 1.8 / 2` -> vertical center of a 0.6 x 1.8 block AABB when in the default state.
          // `t.root_rotated_z_center_offset = 0.6 / 2` -> vertical center of a 0.6 x 0.6 block AABB when in the root rotated state.
          "t.root_rotated_z = (q.is_sleeping || q.is_gliding || q.is_swimming || q.is_crawling || q.can_damage_nearby_mobs); t.player_eye_height = 1.62; t.default_center_offset = 0.9; t.root_rotated_z_center_offset = 0.3; return (t.root_rotated_z ? t.root_rotated_z_center_offset : t.default_center_offset) - t.player_eye_height;",
          0
        ],
        "direction": [
          "math.random(-1.0, 1.0)",
          "math.random(-1.0, 1.0)",
          "math.random(-1.0, 1.0)"
        ]
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "q.movement_direction(0) * 24.0", // inherit a proportion of the entity motion
          -4.0,
          "q.movement_direction(2) * 24.0"
        ],
        "linear_drag_coefficient": "12.0 - (q.modified_move_speed * 3.0)" // less drag as player moves faster
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 * 0.08) + 0.05",
          "(v.particle_random_1 * 0.08) + 0.05"
        ],
        "facing_camera_mode": "rotate_xyz", // lookat_xyz
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [ 16, 32 ],
          "uv_size": [ 7, 7 ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "t.basic_crit_r = (v.particle_random_1 * 0.3) + 0.6; return t.basic_crit_r * 0.3;",
          "t.basic_crit_g = (v.particle_random_1 * 0.3) + 0.6; t.age_progress = v.particle_age / v.particle_lifetime; return math.lerp(t.basic_crit_g * 0.8, 0.425, math.pow(t.age_progress, 1.6));",
          "t.basic_crit_b = (v.particle_random_1 * 0.3) + 0.6; t.age_progress = v.particle_age / v.particle_lifetime; return math.lerp(t.basic_crit_b, 0.3, math.pow(t.age_progress, 1.6));",
          1
        ]
      }
    }
  }
}