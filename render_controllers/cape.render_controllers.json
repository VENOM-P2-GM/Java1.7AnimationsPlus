{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.player.cape": {
      "geometry": "(q.is_emoting || v.is_in_menu) ? geometry.cape : geometry.cape_root_parent",
      "materials": [ { "*": "material.cape" } ],
      "textures": [ "texture.cape" ],
      "part_visibility": [
        { "cape": "(q.armor_texture_slot(1) != 5) && (!v.is_first_person || v.is_paperdoll) && !v.map_face_icon && !q.is_spectator" }
      ],
      "is_hurt_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "on_fire_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      }
    }
  }
}