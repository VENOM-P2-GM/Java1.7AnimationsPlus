//
// The player cape is drawn by a dedicated cape render pass that the engine looks up by name
// (`controller.render.player.cape`); it is intentionally *not* listed in player.entity.json's
// render_controllers array, because the engine adds that pass on its own.
//
// This file mirrors the game's built-in vanilla cape render controller (plus visibility rules
// for the physics segments, see models/entity/cape.geo.json):
// - `rebuild_animation_matrices` is part of the vanilla cape render controller and is required
//   for the cape pass to apply `animation.player.cape` at all. Without it the cape pass re-uses
//   the player model's cached bone matrices (where the `cape` bone does not exist) and the cape
//   renders frozen in its bind pose.
// - The cape pass only auto-applies the `cape` animation, so the `cape_seg_*` segment channels
//   (cape physics) are also defined inside `animation.player.cape`; they cannot be driven by a
//   generic animation in player.entity.json's `animate` list.
// - The geometry is referenced exactly the way vanilla does: plain `Geometry.cape`, no ternary.
//   An earlier version selected `geometry.cape_physics(_root_parent)` through an
//   `(q.is_emoting || v.is_in_menu)` ternary here, and the cape pass stopped rendering entirely.
//   The in-menu pose is already handled inside `animation.player.cape` (`v.is_in_menu ? -6.0`),
//   so switching geometries for menus/emotes is not needed (vanilla never switches either).
// - `geometry.cape` IS the segmented cape model (cape -> cape_seg_1/2/3), and player.entity.json
//   binds the `cape` slot to it as well, so the segmented physics model is used no matter
//   whether the pass resolves geometry through this expression or through the entity slot.
// - The extra part_visibility entries make the three physics segments hide together with the
//   top `cape` bone (elytra equipped, first person, map face icon, spectator). They use the
//   exact same condition vanilla uses for `cape`, so they never change the top bone's behavior.
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.player.cape": {
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.cape",
      "materials": [ { "*": "material.cape" } ],
      "textures": [ "texture.cape" ],
      "part_visibility": [
        { "cape": "(q.armor_texture_slot(1) != 5) && (!v.is_first_person || v.is_paperdoll) && !v.map_face_icon && !q.is_spectator" },
        { "cape_seg_1": "(q.armor_texture_slot(1) != 5) && (!v.is_first_person || v.is_paperdoll) && !v.map_face_icon && !q.is_spectator" },
        { "cape_seg_2": "(q.armor_texture_slot(1) != 5) && (!v.is_first_person || v.is_paperdoll) && !v.map_face_icon && !q.is_spectator" },
        { "cape_seg_3": "(q.armor_texture_slot(1) != 5) && (!v.is_first_person || v.is_paperdoll) && !v.map_face_icon && !q.is_spectator" }
      ],
      "is_hurt_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "on_fire_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      }
    }
  }
}
