{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.player.armor.attachable_bones": {
      "geometry": "geometry.player_armor_custom",
      "materials": [ { "*": "material.default" } ],
      "textures": [ "texture.default" ],
      "part_visibility": [
        { "*": false }
      ]
    },
    "controller.render.player.armor.attachable_bones_elytra": {
      "geometry": "geometry.player_elytra_custom",
      "materials": [ { "*": "material.default" } ],
      "textures": [ "texture.default" ],
      "part_visibility": [
        { "*": false }
      ]
    },
    "controller.render.player.armor.attachable_bones_leggings": {
      "geometry": "geometry.player_armor_leggings_custom",
      "materials": [ { "*": "material.default" } ],
      "textures": [ "texture.default" ],
      "part_visibility": [
        { "*": false }
      ]
    }
  }
}

// These render controllers are needed so that the armor attachables recognize this geoemtry as the parent.
// This way, we can manipulate them from within the player entity in response to, variables that live on the player, without affecting the "hurt" geometry.