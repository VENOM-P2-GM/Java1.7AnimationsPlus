{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.armor.helmet": {
      "geometry": "geometry.default",
      "materials": [ { "*": "v.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "v.has_trim ? v.trim_path : texture.default", "texture.enchanted" ],
      "part_visibility": [
        { "*": false },
        { "head": true },
        { "hat": true }
      ]
    },
    "controller.render.armor.chestplate": {
      "geometry": "geometry.default",
      "materials": [ { "*": "v.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "v.has_trim ? v.trim_path : texture.default", "texture.enchanted" ],
      "part_visibility": [
        { "*": false },
        { "body": true },
        { "leftarm": true },
        { "rightarm": true }
      ]
    },
    "controller.render.armor.elytra": {
      "geometry": "geometry.default", // `geometry.default` is a hardcoded friendly name for the elytra
      "materials": [ { "*": "v.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "v.has_trim ? v.trim_path : texture.default", "texture.enchanted" ],
      "part_visibility": [
        { "*": false },
        { "left_wing": true },
        { "right_wing": true }
      ]
    },
    "controller.render.armor.leggings": {
      "geometry": "geometry.default",
      "materials": [ { "*": "v.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "v.has_trim ? v.trim_path : texture.default", "texture.enchanted" ],
      "part_visibility": [
        { "*": false },
        { "body": true },
        { "leftleg": true },
        { "rightleg": true }
      ]
    },
    "controller.render.armor.boots": {
      "geometry": "geometry.default",
      "materials": [ { "*": "v.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "v.has_trim ? v.trim_path : texture.default", "texture.enchanted" ],
      "part_visibility": [
        { "*": false },
        { "leftleg": true },
        { "rightleg": true }
      ]
    }
  }
}