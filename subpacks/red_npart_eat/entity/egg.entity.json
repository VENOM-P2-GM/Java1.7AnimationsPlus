{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:egg",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/items/egg",

        // these textures will throw content log errors < 1.21.70, although those alone won't break anything
        // currently, it's the best way to achieve backwards compatibility :(
        "warm": "textures/items/brown_egg",
        "cold": "textures/items/blue_egg"
      },
      "geometry": {
        "default": "geometry.item_sprite"
      },
      "animations": {
        "flying": "animation.actor.billboard",
        "particle": "controller.animation.projectile_particle"
      },
      "particle_effects":{
        "basic_crit": "minecraft:basic_crit_particle"
      },
      "scripts": {
        "initialize":[
          "variable.life_time = 0.0;"
        ],
        "pre_animation": [
          "t.variant = query.has_property('minecraft:climate_variant') ? query.property('minecraft:climate_variant') : 'temperate';",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);"
        ],
        "animate": [
          "flying"
          //{ "particle": "query.is_moving" } // query.modified_move_speed >= 0.01
        ]
      },
      "render_controllers": [ "controller.render.egg" ]
    }
  }
}